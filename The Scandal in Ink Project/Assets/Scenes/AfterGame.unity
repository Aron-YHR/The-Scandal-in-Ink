  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "To the loathsome, wretched writer of The Weekly Wag,  \r\n\r\nYou cad! 
    \r\nYou pauper!  \r\nYou insolent wretch! \r\n\r\nFirst, you show up at my home-
    unannounced! - to harass and badger my family! \r\nThen, you accuse me- whilst
    I am in the throes of grief- of murdering my beloved brother! \r\nThen - WORST
    OF ALL \u2013 you condemn me to a life of manacles and striped jumpsuits!  \r\n\r\n
    Rudeness I can forgive, even incarceration- but stripes?!? You have ruined me,
    sir! And I shall have my revenge!  \r\n\r\n My bunkmate- a most endearing fellow
    who goes by the name \u201CGinger Beer\u201D- has helped me craft my first shiv
    from a particularly stale piece of bread. You can be assured that upon my inevitable
    release from this cell, I will seek you out with the express intention of giving
    you a thorough pricking!  \r\n\r\n My idiotic warden tells me that I am only
    permitted to send one letter a month. Well, let me tell you this, SIR- you can
    expect another letter from me one month hence, detailing the many other ways
    in which I will make you suffer!  \r\n\r\nYour Mortal Enemy, \n\r\nMaximillian
    Hold "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 4e2b77087a932ed4ab16fa52a264f232, type: 2}
  m_sharedMaterial: {fileID: 202440264759368882, guid: 4e2b77087a932ed4ab16fa52a264f232, type: 2}
